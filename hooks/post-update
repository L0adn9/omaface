#!/bin/bash
# omaFace after `omarchy update`: rebuild the shell plugin if Omarchy changed
# its lock screen or polkit dialog, and fall back to Omarchy's own lock screen
# if the plugin no longer loads. Never leaves the machine without a lock.
command -v omaface >/dev/null 2>&1 || exit 0
echo "Checking omaFace…"
omaface doctor --after-update || true
