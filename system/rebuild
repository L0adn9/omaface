#!/bin/bash
# Rebuild the omaFace engine after an OpenCV upgrade (pacman hook). A new
# binary only replaces the old one after it passes the self-test; if anything
# fails, omaFace quietly falls back to the password until this is re-run.

SRC=/usr/local/src/omaface/engine
LIB=/usr/local/lib/omaface

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp -a "$SRC/." "$tmp/"
if ! make -C "$tmp" -s omaface-engine >"$tmp/build.log" 2>&1; then
  install -m0644 "$tmp/build.log" /var/log/omaface-rebuild.log
  echo "omaface: engine rebuild failed (see /var/log/omaface-rebuild.log); passwords still work everywhere."
  exit 0
fi
if ! OPENCV_LOG_LEVEL=ERROR "$tmp/omaface-engine" selftest >/dev/null 2>&1; then
  echo "omaface: rebuilt engine failed its self-test; kept the previous one. Passwords still work."
  exit 0
fi
install -m0755 -o root -g root "$tmp/omaface-engine" "$LIB/omaface-engine.new"
mv -f "$LIB/omaface-engine.new" "$LIB/omaface-engine"
rm -f /var/log/omaface-rebuild.log
echo "omaface: engine rebuilt for opencv $(pacman -Q opencv 2>/dev/null | cut -d' ' -f2)"
