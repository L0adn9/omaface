# omaFace configuration. Change it with `omaface enable|disable|set` or the
# omaFace settings window (omaface settings); both keep this file valid.

# Where omaFace is offered. The password always keeps working everywhere.
lock=on
login=on
sudo=on
polkit=on

# Ask first: sudo and system prompts (polkit) wait until you choose omaFace
# (Enter in the terminal, Enter or a click in the dialog) before the camera
# turns on; anything else uses the password. The lock and login screens scan
# by themselves. timeout_choose: seconds before falling back to the password.
confirm=on
timeout_choose=30

# Require attention: only unlock when your eyes are open and on the screen
# (an eye model and a gaze model look at every matching frame).
attention=on

# Matching. Higher threshold = stricter. A match needs this many lit IR
# frames in a row above the threshold, with no other face in view.
threshold=0.55
match_frames=2
min_face_width=70

# Seconds the camera looks before falling back to the password.
timeout_sudo=4
timeout_polkit=5
timeout_lock=6
timeout_login=6

# Laptops without an IR camera use the regular webcam, everywhere: every scan
# also checks the face is live (not a photo or a screen) and, with attention
# on, that the eyes are open and the head faces the screen; sudo and system
# prompts always ask first. The IR camera is always preferred when there is
# one. head_turns=on adds a few random head turns on the webcam (strictest).
rgb_fallback=on
head_turns=off
threshold_rgb=0.60

# IR camera: auto picks the greyscale camera named "IR".
device=auto
