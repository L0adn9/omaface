# Maintainer: L0adn9 <70851700+L0adn9@users.noreply.github.com>

pkgname=omaface
pkgver=1.2.0
pkgrel=1
pkgdesc='Face unlock for Omarchy: lock screen, login, sudo and polkit, with an IR camera or a regular webcam'
arch=('x86_64')
url='https://github.com/L0adn9/omaface'
license=('MIT' 'Apache-2.0')
depends=('opencv' 'pam' 'polkit' 'systemd' 'systemd-libs' 'python' 'jq' 'glibc' 'gcc-libs')
makedepends=('pkgconf')
optdepends=('sddm: face unlock at the login screen'
            'linux-enable-ir-emitter: switches on the IR light on laptops that keep it off')
install=omaface.install
# The face models are not redistributed in the repository; they come from
# their authors' own releases, pinned by hash (see models/SOURCES).
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx'
        'https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx'
        'https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV2.onnx'
        'https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV1SE.onnx'
        'https://storage.googleapis.com/mediapipe-assets/iris_landmark.tflite'
        'https://github.com/yakhyo/gaze-estimation/releases/download/weights/mobileone_s0_gaze.onnx')
sha256sums=('340c2dfb64a2ed993afd9331b410f72faa068004ea577bc27e253042e89804b1'
            '8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'
            '0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79'
            'b32929adc2d9c34b9486f8c4c7bc97c1b69bc0ea9befefc380e4faae4e463907'
            'ebab7f90c7833fbccd46d3a555410e78d969db5438e169b6524be444862b3676'
            'd1744d2a09c25f501d39eba4faff47e53ecca8852c5ce19bce8eeac39357521f'
            '8b4fdc4e3da44733c9a82e7776b411e4a39f94e8e285aee0fc85a548a55f7d9f')

build() {
  make -C "$pkgname-$pkgver/engine" PREFIX=/usr
}

package() {
  cd "$pkgname-$pkgver"
  # The same file set as the git install, in /usr. PAM, the login screen and
  # the shell plugin are left alone: `omaface setup` does those, per user.
  bash system/install-files.sh "$PWD" engine "$srcdir" "$pkgdir" /usr /usr/lib/systemd/system /usr/lib/tmpfiles.d
  install -Dm0644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm0644 models/SOURCES "$pkgdir/usr/share/licenses/$pkgname/MODELS"
}
