#!/bin/bash

# omaface — omaFace, face unlock for Omarchy: the lock screen, login
# screen, sudo and polkit prompts. The password always keeps working.

set -euo pipefail

# Filled in when installed: /usr for the package, /usr/local from git.
PREFIX=@PREFIX@
LIB=$PREFIX/lib/omaface
SHARE=$PREFIX/share/omaface
CONF=/etc/omaface/config
SDDM_CONF=/etc/sddm.conf.d/20-omaface.conf
SDDM_THEME=/usr/share/sddm/themes/omaface
PLUGIN_ID=io.github.l0adn9.omaface
PLUGIN_DEST="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
PLUGIN_BACKUPS="$HOME/.local/share/omarchy-plugin-backups"
PLACES=(lock login sudo polkit)
MAX_APPEARANCES=3 # kMaxAppearances in the engine

# Where the PAM lines go and whether SDDM is in use; installed with omaFace.
if [[ -r $LIB/pam.sh ]]; then
  source "$LIB/pam.sh"
else
  sddm_autologin_user() { :; }
fi

die() { echo "omaface: $*" >&2; exit 1; }

# The package is rebuilt by pacman; a git install keeps its own sources and
# rebuild hook, and its own uninstall.
packaged() { [[ $PREFIX == /usr ]]; }
reinstall_hint() { if packaged; then echo "reinstall the omaface package"; else echo "re-run install.sh"; fi; }

usage() {
  cat <<'USAGE'
Usage: omaface <command>

  setup                      set omaFace up for you: PAM, lock screen, polkit dialog
  status [--json]            what is set up and where omaFace is used
  cameras                    list cameras and which one omaFace uses
  emitter                    check that the IR light comes on
  enroll [--name NAME]       add your face (or an alternate appearance)
  test                       look at the screen and see if you are recognized
  rename <N> <name>          rename appearance N (see status)
  remove <N|all>             remove appearance N (see status) or all of them
  enable  <place...|all>     use omaFace for: lock login sudo polkit
  disable <place...|all>     stop using omaFace there (password only)
  set <key> <value>          attention on|off, confirm on|off, head_turns on|off, threshold, match_frames,
                             timeout_{sudo,polkit,lock,login,choose}
  settings                   open the omaFace settings window
  doctor                     check every part of the installation
  sync                       rebuild the shell plugin after an Omarchy update
  uninstall [--keep-data]    remove omaFace and restore the original setup
USAGE
}

# ------------------------------------------------------------------ helpers

# Commands that change system state re-run themselves as root: sudo in a
# terminal, pkexec from the settings window.
as_root() {
  (( EUID == 0 )) && return 0
  if [[ -t 0 ]]; then
    exec sudo "$0" "$@"
  else
    exec pkexec "$PREFIX/bin/omaface" "$@"
  fi
}

# The same, but coming back: setup and uninstall have a root half in the
# middle of their user half.
run_root() {
  if [[ -t 0 ]]; then
    sudo "$PREFIX/bin/omaface" "$@"
  else
    pkexec "$PREFIX/bin/omaface" "$@"
  fi
}

step() { printf '\n\e[1m==> %s\e[0m\n' "$*"; }

target_user() {
  if [[ -n ${PKEXEC_UID:-} ]]; then
    getent passwd "$PKEXEC_UID" | cut -d: -f1
  elif [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
    echo "$SUDO_USER"
  elif (( EUID != 0 )); then
    id -un
  else
    die "run through sudo or pkexec so omaFace knows whose face this is"
  fi
}

conf_get() {
  local key=$1 fallback=$2 value
  value=$(sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\([^#[:space:]]*\).*/\1/p" "$CONF" 2>/dev/null | tail -1)
  echo "${value:-$fallback}"
}

conf_set() {
  local key=$1 value=$2 tmp
  # Before setup (choosing the camera when none was found) there is none yet.
  [[ -f $CONF ]] || install -Dm0644 "$SHARE/config" "$CONF"
  tmp=$(mktemp /etc/omaface/.config.XXXXXX)
  if grep -qE "^[[:space:]]*$key[[:space:]]*=" "$CONF"; then
    sed "s|^[[:space:]]*$key[[:space:]]*=.*|$key=$value|" "$CONF" >"$tmp"
  else
    cat "$CONF" >"$tmp"
    echo "$key=$value" >>"$tmp"
  fi
  chmod 0644 "$tmp"
  mv "$tmp" "$CONF"
}

is_on() { [[ $(conf_get "$1" off) =~ ^(on|yes|true|1)$ ]]; }

json_bool() { if "$@"; then echo true; else echo false; fi; }

# The installer set the login screen up only where SDDM is the login manager.
login_supported() { [[ -f $SDDM_THEME/Main.qml ]] && grep -q omaface-pam /etc/pam.d/sddm 2>/dev/null; }

socket_active() { systemctl is-active --quiet omaface.socket 2>/dev/null; }

# IR: 5 rejected scans pause omaFace for 5 minutes. Webcam: 3 failed scans
# pause it until the password is used (sticky).
locked_out() {
  local f=/run/omaface/fail-$(id -u "$1") count last sticky
  [[ -r $f ]] || return 1
  read -r count last sticky <"$f" || return 1
  if [[ ${sticky:-0} == 1 ]]; then (( count >= 3 )); else (( count >= 5 && $(date +%s) - last <= 300 )); fi
}

# "ir", or "webcam" (no IR camera found, so the regular webcam with the
# head-turn check), or nothing.
camera_kind() { "$LIB/omaface-engine" probe 2>/dev/null | cut -f5; }

appearances_json() { "$LIB/omaface-engine" list "$1" 2>/dev/null || echo "[]"; }

appearance_count() { appearances_json "$1" | { grep -o '"name"' || true; } | wc -l; }

# ------------------------------------------------------------------ commands

cmd_status() {
  local user json=0
  [[ ${1:-} == --json ]] && json=1
  user=$(id -un)
  (( EUID == 0 )) && user=$(target_user)

  local installed=false
  [[ -x $LIB/omaface-engine && -r $CONF ]] && installed=true

  if (( json )); then
    local places="" p
    for p in "${PLACES[@]}"; do places+="${places:+,}\"$p\":$(json_bool is_on "$p")"; done
    printf '{"installed":%s,"service":%s,"user":"%s","appearances":%s,"maxAppearances":%d,"places":{%s},"attention":%s,"confirm":%s,"cameraKind":"%s","rgbFallback":%s,"headTurns":%s,"loginSupported":%s,"autologin":%s,"lockedOut":%s,"camera":"%s"}\n' \
      "$installed" "$(json_bool socket_active)" "$user" "$(appearances_json "$user")" "$MAX_APPEARANCES" "$places" \
      "$([[ $(conf_get attention on) == off ]] && echo false || echo true)" \
      "$([[ $(conf_get confirm on) == off ]] && echo false || echo true)" "$(camera_kind)" \
      "$([[ $(conf_get rgb_fallback on) == off ]] && echo false || echo true)" \
      "$([[ $(conf_get head_turns off) == on ]] && echo true || echo false)" \
      "$(json_bool login_supported)" "$([[ -n $(sddm_autologin_user) ]] && echo true || echo false)" \
      "$(json_bool locked_out "$user")" "$("$LIB/omaface-engine" probe 2>/dev/null | cut -f1,2 | tr '\t' ' ' | tr -d '"\\')"
    return
  fi

  [[ $installed == true ]] || die "not installed"
  local count
  count=$(appearance_count "$user")
  echo "omaFace for $user"
  echo "  camera       $("$LIB/omaface-engine" probe 2>/dev/null | cut -f2 || echo none)$([[ $(camera_kind) == webcam ]] && echo "  (no IR camera: regular webcam with anti-spoofing)")"
  echo "  service      $(socket_active && echo ready || echo stopped)"
  echo "  appearances  $count"
  "$LIB/omaface-engine" list "$user" 2>/dev/null | tr '{' '\n' | sed -n 's/.*"name":"\([^"]*\)","created":"\([^"]*\)".*/\1  \2/p' |
    nl -w5 -s'  ' | sed 's/T/ /'
  local p
  for p in "${PLACES[@]}"; do
    if [[ $p == login ]] && ! login_supported; then printf '  %-12s %s\n' login "not available (SDDM is not the login manager)"; continue; fi
    printf '  %-12s %s\n' "$p" "$(is_on "$p" && echo on || echo off)"
  done
  if login_supported && [[ -n $(sddm_autologin_user) ]]; then echo "  (SDDM signs you in automatically, so the login screen does not show)"; fi
  printf '  %-12s %s\n' ask-first "$([[ $(conf_get confirm on) == off ]] && echo "off (sudo and system prompts scan right away)" || echo "on (sudo and system prompts wait for Enter or a click)")"
  printf '  %-12s %s\n' attention "$([[ $(conf_get attention on) == off ]] && echo "off (any open or closed eyes)" || echo "on (eyes open, on the screen)")"
  if locked_out "$user"; then echo "  paused after too many failed scans (use your password once to resume)"; fi
  return 0
}

# Exit 0 when omaFace will actually be tried for <place>: used by the lock
# screen and polkit dialog to decide whether to show the omaFace mark.
cmd_ready() {
  local place=${1:-} user
  user=$(id -un)
  [[ -r $CONF ]] || return 1
  is_on "$place" || return 1
  socket_active || return 1
  [[ $(appearance_count "$user") -gt 0 ]] || return 1
  return 0
}

select_login_theme() {
  [[ -f $SDDM_THEME/Main.qml ]] || return 0
  write_login_conf "$SDDM_CONF"
}

cmd_enroll() {
  as_root enroll "$@"
  local user
  user=$(target_user)
  "$LIB/omaface-engine" enroll "$user" "$@" || return $?
  # The login screen switches to the omaFace theme once there is a face.
  if is_on login && [[ ! -f $SDDM_CONF ]]; then select_login_theme; fi
  return 0
}

cmd_remove() {
  [[ -n ${1:-} ]] || die "usage: omaface remove <N|all>"
  [[ $1 == all || $1 =~ ^[0-9]+$ ]] || die "usage: omaface remove <N|all>"
  as_root remove "$@"
  "$LIB/omaface-engine" remove "$(target_user)" "$1"
}

# The polkit dialog's answer to "omaFace or password?" (sudo answers in the
# terminal). Goes through the socket, since only the engine may write /run/omaface.
cmd_choose() {
  [[ ${1:-} == face || ${1:-} == password ]] || die "usage: omaface choose <face|password>"
  python3 -I - "$1" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
s.connect("/run/omaface.sock")
s.sendall(f"CHOOSE {sys.argv[1]}\n".encode())
reply = s.recv(256).decode(errors="replace").strip()
sys.exit(0 if reply == "RESULT ok" else 1)
PY
}

# After the password unlocks: rejected scans no longer count (the lock
# screen calls this). Through the socket; only the engine writes /run/omaface.
cmd_reset() {
  python3 -I - <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
s.connect("/run/omaface.sock")
s.sendall(b"RESET\n")
sys.exit(0 if s.recv(256).decode(errors="replace").strip() == "RESULT ok" else 1)
PY
}

cmd_cameras() {
  "$LIB/omaface-engine" cameras | awk -F'\t' '{ printf "  %-12s %-36s %-18s %s\n", $1, $2, $3, $4 }'
}

cmd_emitter() {
  local out
  out=$("$LIB/omaface-engine" emitter 2>/dev/null || true)
  case $out in
    *'"pulsing"'*) echo "IR light: on, pulsing every other frame (normal)" ;;
    *'"steady"'*) echo "IR light: on, or the room is bright in infrared (sunlight)" ;;
    *'"dark"'*)
      cat <<'EOF'
IR light: off. The camera only sees ambient light, so omaFace will rarely
find a face. Many laptops need the light switched on once:
    omarchy pkg aur add linux-enable-ir-emitter
    sudo linux-enable-ir-emitter configure
EOF
      return 1 ;;
    *'"busy"'*) echo "IR light: camera busy, try again in a moment"; return 1 ;;
    *) echo "IR light: could not check ($out)"; return 1 ;;
  esac
}

cmd_rename() {
  [[ ${1:-} =~ ^[0-9]+$ && -n ${2:-} ]] || die "usage: omaface rename <N> <name>"
  local n=$1
  shift
  as_root rename "$n" "$@"
  "$LIB/omaface-engine" rename "$(target_user)" "$n" "$*"
}

cmd_toggle() {
  local action=$1
  shift
  (( $# > 0 )) || die "usage: omaface $action <lock|login|sudo|polkit|all>"
  local places=() p
  for p in "$@"; do
    if [[ $p == all ]]; then places+=("${PLACES[@]}"); continue; fi
    [[ " ${PLACES[*]} " == *" $p "* ]] || die "unknown place '$p' (lock, login, sudo, polkit, all)"
    places+=("$p")
  done
  as_root "$action" "$@"
  for p in "${places[@]}"; do
    if [[ $action == enable ]]; then
      if [[ $p == login ]] && ! login_supported; then
        echo "omaFace for login: not available (SDDM is not the login manager)"
        continue
      fi
      conf_set "$p" on
      if [[ $p == login ]]; then
        if [[ $(appearance_count "$(target_user)") -gt 0 ]]; then select_login_theme
        else echo "  (the login screen switches to omaFace after: omaface enroll)"; fi
      fi
    else
      conf_set "$p" off
      [[ $p == login ]] && rm -f "$SDDM_CONF"
    fi
    echo "omaFace for $p: $([[ $action == enable ]] && echo on || echo off)"
  done
}

cmd_set() {
  local key=${1:-} value=${2:-}
  case "$key" in
    threshold) [[ $value =~ ^0\.[3-9][0-9]*$ ]] || die "threshold must be between 0.30 and 0.99" ;;
    match_frames) [[ $value =~ ^[1-5]$ ]] || die "match_frames must be 1-5" ;;
    timeout_sudo | timeout_polkit | timeout_lock | timeout_login)
      [[ $value =~ ^([1-9]|1[0-5])$ ]] || die "$key must be 1-15 seconds" ;;
    min_face_width) [[ $value =~ ^[0-9]{2,3}$ ]] || die "min_face_width must be 30-300" ;;
    attention | confirm | rgb_fallback | head_turns) [[ $value == on || $value == off ]] || die "$key must be on or off" ;;
    threshold_rgb) [[ $value =~ ^0\.[3-9][0-9]*$ ]] || die "threshold_rgb must be between 0.30 and 0.99" ;;
    timeout_choose) [[ $value =~ ^([5-9]|[1-9][0-9]|1[01][0-9]|120)$ ]] || die "timeout_choose must be 5-120 seconds" ;;
    device) [[ $value == auto || $value =~ ^/dev/(video[0-9]+|v4l/by-(id|path)/[A-Za-z0-9._:-]+)$ ]] || die "device must be auto or a /dev/video path" ;;
    *) die "unknown setting '$key'" ;;
  esac
  as_root set "$@"
  conf_set "$key" "$value"
  echo "$key=$value"
}

# Self-check through the real socket. Never authenticates anything: the
# engine treats omaface-test as a dry run and the caller only sees scores.
cmd_test() {
  local json=0
  [[ ${1:-} == --json ]] && json=1
  socket_active || die "service not running (omaface doctor)"
  # exec: stopping the test (Esc in the settings window) must reach the client
  # holding the socket, or the engine keeps scanning until its timeout.
  exec python3 -I - "$(id -un)" "$json" <<'PY'
import json, socket, sys
user, as_json = sys.argv[1], sys.argv[2] == "1"
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(20)
s.connect("/run/omaface.sock")
s.sendall(f"VERIFY {user} omaface-test\n".encode())
best, buf = None, b""
messages = {"fail": "Not recognized", "timeout": "No face found", "locked-out": "Paused after too many attempts",
            "busy": "Camera busy", "disabled": "omaFace is off",
            "attention": "Recognized, but your eyes were closed or not on the screen"}
moves = {"turn-left": "<- turn your head LEFT", "turn-right": "turn your head RIGHT ->", "turn-back": "face the camera again"}
liveness = {"spoof": "it did not look like a live face (a photo or a screen?)", "wrong": "moved the wrong way", "slow": "did not follow in time", "early": "moved before being asked",
            "lost": "the face left the camera or was swapped", "identity": "a different face turned back"}
eyes = {"ok": "paying attention", "eyes": "eyes closed",
        "away": "looking away from the screen", "head": "head turned or tilted away", "off": "attention off"}
seen_attention = set()
def out(obj, text):
    print(json.dumps(obj) if as_json else text, flush=True)
if not as_json:
    print("Look at the screen…", flush=True)
while True:
    try:
        chunk = s.recv(4096)
    except socket.timeout:
        break
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        parts = line.decode(errors="replace").split()
        if not parts:
            continue
        if parts[0] == "STATUS":
            if as_json:
                out({"type": "status", "state": parts[1]}, "")
            elif parts[1] in moves:
                print(f"  {moves[parts[1]]}", flush=True)
        elif parts[0] == "SCORE":
            score = float(parts[1])
            best = score if best is None else max(best, score)
            attention = parts[5] if len(parts) > 5 and parts[4] == "attention" else "off"
            live = float(parts[7]) if len(parts) > 7 and parts[6] == "live" else -1.0
            seen_attention.add(attention)
            if not as_json:
                real = f"   real face {live:.2f}" if live >= 0 else ""
                print(f"  score {score:.3f}   {eyes.get(attention, attention)}{real}", flush=True)
            else:
                out({"type": "score", "score": score, "attention": attention, "live": live}, "")
        elif parts[0] == "RESULT":
            result = parts[1]
            detail = " ".join(parts[2:])
            message = messages.get(result, (result + " " + detail).strip())
            if result == "fail" and detail == "liveness spoof":
                message = "Recognized, but it did not look like a live face (a photo or a screen?)"
            elif result == "fail" and detail.startswith("liveness"):
                message = "Recognized, but the head-turn check failed: " + liveness.get(detail.split()[-1], detail)
            elif result == "timeout" and detail in ("unsettled", "crowd"):
                message = {"unsettled": "Recognized, but you did not face the camera long enough to be asked",
                           "crowd": "More than one face in view"}[detail]
            if result == "unavailable" and detail.startswith("not-enrolled"):
                message = "Camera works, but no face is enrolled yet" if "no-face-seen" not in detail \
                    else "No face enrolled yet (and none seen by the camera)"
            elif result == "unavailable":
                message = {"lid-closed": "Lid is closed", "camera": "Camera unavailable",
                           "no-camera": "No IR camera found"}.get(detail, message)
            out({"type": "result", "result": result, "score": best, "message": message,
                 "attention": sorted(seen_attention)},
                ("Recognized" if result == "ok" else message) + (f"  (best {best:.3f})" if best is not None else ""))
            sys.exit(0 if result == "ok" else 1)
sys.exit(1)
PY
}

cmd_settings() {
  omarchy-shell omaface settings >/dev/null || die "the omaFace shell plugin is not running (omaface doctor)"
}

# build_plugin <out>: the shell plugin, from Omarchy's current lock screen and
# polkit dialog plus omaFace's patches, passed by Omarchy's validator.
build_plugin() {
  python3 -I "$SHARE/tools/build-plugin.py" --prefix "$PREFIX" "$SHARE/plugin" "$1" >/dev/null || return 1
  if ! omarchy plugin validate "$1" >/dev/null; then
    echo "omaface: the built plugin failed Omarchy's manifest validation" >&2
    rm -rf "$1"
    return 1
  fi
}

# replace_plugin <built>: put a built plugin in place. The previous copy goes
# to the backups, of which the three newest are kept; prints its path.
replace_plugin() {
  local backup=""
  mkdir -p "$(dirname "$PLUGIN_DEST")" "$PLUGIN_BACKUPS"
  if [[ -d $PLUGIN_DEST ]]; then
    backup="$PLUGIN_BACKUPS/$PLUGIN_ID-$(date +%Y%m%d-%H%M%S)"
    cp -a "$PLUGIN_DEST" "$backup"
  fi
  rm -rf "$PLUGIN_DEST.new"
  cp -a "$1" "$PLUGIN_DEST.new"
  rm -rf "$PLUGIN_DEST"
  mv "$PLUGIN_DEST.new" "$PLUGIN_DEST"
  ls -1d "$PLUGIN_BACKUPS/$PLUGIN_ID"-* 2>/dev/null | sort | head -n -3 | xargs -r rm -rf
  echo "$backup"
}

cmd_sync() {
  (( EUID != 0 )) || die "run sync as your user, not root"
  [[ -d $PLUGIN_DEST ]] || die "not set up for you yet: omaface setup"
  local stage="${XDG_RUNTIME_DIR:-/tmp}/omaface-plugin.$$" backup="" changed=0
  build_plugin "$stage" || return 1
  if diff -rq "$stage" "$PLUGIN_DEST" >/dev/null 2>&1; then
    rm -rf "$stage"
    echo "Plugin already up to date."
  else
    backup=$(replace_plugin "$stage")
    rm -rf "$stage"
    changed=1
    echo "Plugin rebuilt${backup:+ (previous copy in $backup)}."
  fi

  # An Omarchy update hands the lock back to Omarchy's own plugins when the
  # old build no longer loads. A sync is an explicit request to use omaFace,
  # so restore the handover when omaFace is configured for the lock or polkit.
  if ! plugin_enabled || ! stock_handed_over; then
    if plugin_enabled || is_on lock || is_on polkit; then
      omarchy plugin disable omarchy.polkit >/dev/null 2>&1 || true
      omarchy plugin enable "$PLUGIN_ID" >/dev/null 2>&1 || true
      changed=1
    fi
  fi

  if (( !changed )); then
    if plugin_enabled; then
      echo "omaFace plugin is live."
      return 0
    fi
    echo "omaface: the plugin is not enabled; run: omaface setup" >&2
    return 1
  fi
  if ! plugin_enabled; then
    echo "omaface: the plugin is not enabled; run: omaface setup" >&2
    return 1
  fi

  echo "Restarting the shell to load it…"
  omarchy restart shell >/dev/null 2>&1 || true
  if wait_plugin_live; then
    echo "omaFace plugin is live."
    return 0
  fi
  echo "omaface: the rebuilt plugin did not come up; restoring the previous copy" >&2
  if [[ -n $backup && -d $backup ]]; then
    rm -rf "$PLUGIN_DEST"
    cp -a "$backup" "$PLUGIN_DEST"
    omarchy restart shell >/dev/null 2>&1 || true
    wait_plugin_live && { echo "Previous plugin restored."; return 1; }
  fi
  fallback_to_stock
  return 1
}

# Omarchy 4.5 keeps plugin enablement in its registry; older releases only
# record the stock handover in shell.json, so fall back to that.
plugin_registry() {
  local out
  out=$(timeout 5 omarchy plugin list --json 2>/dev/null) || return 1
  jq -e 'type == "array" and any(.[]; has("enabled"))' <<<"$out" >/dev/null 2>&1 || return 1
  printf '%s\n' "$out"
}

plugin_enabled() {
  local out
  if out=$(plugin_registry); then
    jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled)' <<<"$out" >/dev/null 2>&1
  else
    jq -e --arg id "$PLUGIN_ID" '(.disabledPlugins // []) | index($id) | not' \
      "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1
  fi
}

stock_handed_over() {
  local out
  if out=$(plugin_registry); then
    jq -e 'type == "array"
      and any(.[]; .id == "omarchy.lock" and (.enabled | not))
      and any(.[]; .id == "omarchy.polkit" and (.enabled | not))' <<<"$out" >/dev/null 2>&1
  else
    jq -e '(.disabledPlugins // []) | (index("omarchy.lock") != null and index("omarchy.polkit") != null)' \
      "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1
  fi
}

plugin_live() {
  local out
  out=$(timeout 3 omarchy-shell omaface status 2>/dev/null) || return 1
  [[ $out == *"\"plugin\":\"$PLUGIN_ID\""* && $out == *'"polkitRegistered":true'* ]]
}

wait_plugin_live() {
  local i
  for i in $(seq 1 30); do
    plugin_live && return 0
    sleep 0.5
  done
  return 1
}

# Never leave the machine without a working lock screen or polkit agent:
# hand both back to Omarchy's own plugins.
fallback_to_stock() {
  echo "omaface: switching back to Omarchy's own lock screen and polkit dialog" >&2
  omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  omarchy plugin enable omarchy.lock >/dev/null 2>&1 || true
  omarchy plugin enable omarchy.polkit >/dev/null 2>&1 || true
  omarchy restart shell >/dev/null 2>&1 || true
  notify-send -u critical "omaFace" "The omaFace plugin failed to load, so Omarchy's own lock screen is back. Run: omaface doctor" 2>/dev/null || true
}

cmd_doctor() {
  local mode=${1:-}
  local fails=0 warns=0
  ok()   { [[ $mode == --quiet ]] || printf '  \e[32mok\e[0m    %s\n' "$*"; }
  warn() { printf '  \e[33mwarn\e[0m  %s\n' "$*"; warns=$((warns + 1)); }
  bad()  { printf '  \e[31mFAIL\e[0m  %s\n' "$*"; fails=$((fails + 1)); }

  [[ $mode == --quiet ]] || echo "omaFace doctor"
  local user
  user=$(id -un)

  if [[ -x $LIB/omaface-engine && -x $LIB/omaface-pam ]]; then ok "binaries installed"; else bad "binaries missing in $LIB ($(reinstall_hint))"; fi
  # After an OpenCV upgrade: a git install rebuilds itself, the package
  # needs rebuilding like any AUR package.
  local rebuild="sudo $LIB/rebuild"
  packaged && rebuild="rebuild the omaface package against the new OpenCV"
  if ldd "$LIB/omaface-engine" 2>/dev/null | grep -q 'not found'; then
    bad "engine cannot find its OpenCV libraries: $rebuild"
  elif "$LIB/omaface-engine" selftest >/dev/null 2>&1; then
    ok "engine self-test (models + OpenCV)"
  else
    bad "engine self-test failed: $rebuild"
  fi
  if (cd "$SHARE/models" && sha256sum -c --quiet SHA256SUMS) >/dev/null 2>&1; then ok "model files verified"; else bad "model checksums do not match"; fi
  if socket_active; then ok "omaface.socket listening"; else bad "omaface.socket not active: sudo systemctl enable --now omaface.socket"; fi
  [[ -d /run/omaface ]] && ok "/run/omaface present" || bad "/run/omaface missing: sudo systemd-tmpfiles --create omaface.conf"

  local cam
  if cam=$("$LIB/omaface-engine" probe 2>/dev/null); then
    if [[ $(cut -f5 <<<"$cam") == webcam ]]; then
      ok "regular webcam: $(cut -f1,2 <<<"$cam" | tr '\t' ' ') (no IR camera found; anti-spoofing on every scan)"
    else
      ok "IR camera: $(cut -f1,2 <<<"$cam" | tr '\t' ' ') ($(cut -f4 <<<"$cam"))"
    fi
    # A webcam chosen with device= while an IR camera is there: allowed (it is
    # how to try webcam mode), but the IR camera is the stronger choice.
    if [[ $(cut -f5 <<<"$cam") == webcam && $(conf_get device auto) != auto ]] &&
      "$LIB/omaface-engine" cameras 2>/dev/null | grep -q "IR candidate"; then
      warn "the webcam is chosen with device=, but this laptop has an IR camera (stronger): omaface set device auto"
    fi
  else
    bad "no IR camera found (omaface cameras lists what is there)"
  fi
  # Turning the camera on is only done when someone asked for the doctor,
  # never in the quiet runs after updates.
  if [[ -z $mode && $(cut -f5 <<<"${cam:-}") == ir ]]; then
    local light
    light=$("$LIB/omaface-engine" emitter 2>/dev/null || true)
    case $light in
      *'"pulsing"'* | *'"steady"'*) ok "IR light comes on" ;;
      *'"dark"'*) warn "IR light stays off: omaface emitter (says how to switch it on)" ;;
      *) warn "IR light not checked (camera busy)" ;;
    esac
  fi

  grep -q omaface-pam /etc/pam.d/sudo 2>/dev/null && ok "PAM: sudo" || bad "PAM: sudo line missing: omaface setup"
  grep -q omaface-pam /etc/pam.d/polkit-1 2>/dev/null && ok "PAM: polkit" || bad "PAM: polkit line missing: omaface setup"
  if login_supported; then ok "PAM: login (sddm)"
  elif is_on login && [[ -f $SDDM_THEME/Main.qml ]]; then bad "PAM: sddm line missing"; fi
  [[ -f /etc/pam.d/omaface-lock ]] && ok "PAM: lock screen" || bad "PAM: /etc/pam.d/omaface-lock missing: omaface setup"
  if declare -F pam_anchor >/dev/null; then
    if pam_anchor /etc/pam.d/sudo "${PAM_ANCHORS_SUDO[@]}" >/dev/null &&
      pam_anchor /etc/pam.d/polkit-1 "${PAM_ANCHORS_POLKIT[@]}" >/dev/null; then
      ok "password fallback intact (sudo, polkit)"
    else
      bad "password lines missing from sudo/polkit PAM"
    fi
  fi

  local count
  count=$(appearance_count "$user")
  if login_supported && [[ -n $(sddm_autologin_user) ]]; then
    ok "login screen skipped by SDDM autologin (omaFace is ready if you turn it off)"
  fi
  if login_supported && is_on login; then
    if [[ -f $SDDM_CONF && -f $SDDM_THEME/Main.qml ]]; then ok "login screen uses the omaFace theme"
    elif (( count == 0 )); then ok "login screen switches to the omaFace theme after you enroll"
    else bad "login is on but the theme is not selected: omaface enable login"; fi
  fi
  local stock_main=/usr/share/sddm/themes/omarchy/Main.qml
  local stock_hash=/var/lib/omaface/sddm-upstream.sha256
  if login_supported && [[ -f $stock_hash && -f $stock_main ]]; then
    if [[ $(sha256sum "$stock_main" | cut -d' ' -f1) == "$(cat "$stock_hash")" ]]; then
      ok "Omarchy login theme unchanged since setup"
    else
      warn "Omarchy updated its login theme; the omaFace theme still works but may look older until omaFace is updated"
    fi
  fi

  if (( count > 0 )); then ok "$count appearance(s) enrolled for $user"; else warn "no face enrolled: omaface enroll"; fi
  if locked_out "$user"; then warn "paused for 5 minutes after too many failed scans"; fi

  local plugin_dir=$PLUGIN_DEST
  if [[ -f $plugin_dir/manifest.json ]]; then ok "shell plugin installed"; else bad "shell plugin missing: omaface setup"; fi
  if plugin_enabled; then
    ok "omaFace plugin enabled"
  else
    bad "omaFace plugin is disabled: omaface setup"
  fi
  if stock_handed_over; then
    ok "stock lock + polkit plugins handed over"
  else
    bad "omarchy.lock / omarchy.polkit still enabled next to omaFace: omaface setup"
  fi
  local live=1
  if [[ $mode == --after-update ]]; then wait_plugin_live || live=0; else plugin_live || live=0; fi
  if (( live )); then
    ok "lock screen + polkit dialog live in the shell"
  else
    bad "omaFace plugin not answering in the shell: omarchy restart shell"
    if [[ $mode == --after-update ]]; then fallback_to_stock; fi
  fi

  if [[ -f $plugin_dir/upstream.json ]]; then
    local drift
    drift=$(python3 -I - "$plugin_dir/upstream.json" <<'PY'
import hashlib, json, os, sys
data = json.load(open(sys.argv[1]))
# Omarchy's files the plugin was patched from, then omaFace's own (which an
# upgrade of omaFace changes; builds from before have no "own").
for base, hashes in ((data["upstream"], data["sha256"]), (data.get("source", ""), data.get("own", {}))):
    for rel, digest in hashes.items():
        try:
            now = hashlib.sha256(open(os.path.join(base, rel), "rb").read()).hexdigest()
        except OSError:
            now = "missing"
        if now != digest:
            print(rel)
PY
)
    if [[ -z $drift ]]; then
      ok "built from the current Omarchy lock screen and polkit dialog"
    elif [[ $mode == --after-update ]]; then
      echo "  changed since the plugin was built: $(tr '\n' ' ' <<<"$drift")— rebuilding it"
      if cmd_sync; then ok "plugin rebuilt"; else bad "plugin rebuild failed, kept the working copy"; fi
    else
      warn "changed since the plugin was built: $(tr '\n' ' ' <<<"$drift")— run: omaface sync"
    fi
  fi

  # The package depends on opencv; a git install keeps it explicit and
  # rebuilds itself when it changes.
  if ! packaged; then
    [[ -f /etc/pacman.d/hooks/omaface.hook ]] && ok "rebuild hook for OpenCV upgrades" || warn "pacman rebuild hook missing"
    if pacman -Qi opencv 2>/dev/null | grep -q 'Install Reason *: Explicitly'; then ok "opencv kept as an explicit package"; else warn "opencv is only a dependency; an orphan cleanup could remove it: sudo pacman -D --asexplicit opencv"; fi
  fi

  if [[ $mode != --quiet ]]; then
    echo
    if (( fails )); then echo "$fails problem(s), $warns warning(s)"; elif (( warns )); then echo "All good, $warns warning(s)"; else echo "All good"; fi
  fi
  if [[ $mode == --after-update ]] && (( fails )); then
    notify-send -u critical "omaFace" "$fails problem(s) after the update. Run: omaface doctor" 2>/dev/null || true
  fi
  (( fails == 0 ))
}

# Wire omaFace in for the user who runs it: settings, PAM and the service
# (root), then the shell plugin that takes over the lock screen and polkit
# dialog. Idempotent: the git installer runs it on every upgrade. Like
# Omarchy's fingerprint setup, the package leaves this to the user.
cmd_setup() {
  (( EUID != 0 )) || die "run setup as your user; it asks for root itself"
  [[ -x $LIB/omaface-engine ]] || die "omaFace is not installed ($LIB is missing)"

  step "Checking this machine"
  omaface_preflight || exit 1
  echo "  ok"

  step "Finding the camera"
  local cam webcam=no what
  if ! cam=$("$LIB/omaface-engine" probe 2>/dev/null) && ! cam=$("$LIB/omaface-engine" probe webcam 2>/dev/null); then
    echo "  Cameras on this machine:" >&2
    "$LIB/omaface-engine" cameras 2>/dev/null | sed 's/^/    /' >&2 || true
    die "no camera found. If yours is listed above but not picked: omaface set device /dev/videoN, then omaface setup"
  fi
  [[ $(cut -f5 <<<"$cam") == webcam ]] && webcam=yes
  what="$(cut -f2 <<<"$cam") ($(cut -f1 <<<"$cam"), $(cut -f4 <<<"$cam") $(cut -f3 <<<"$cam"))"
  if [[ $webcam == yes ]]; then
    # Found automatically: no IR camera, so the regular webcam, everywhere,
    # with the checks that keep it safe. Nothing to decide; Settings shows it.
    # Or chosen by hand with device=, which says nothing about IR.
    echo "  Webcam: $what"
    if [[ $(conf_get device auto) != auto ]]; then
      echo "  (chosen with device= in $CONF; omaface set device auto picks an IR camera first)"
    fi
    cat <<'EOF'
  omaFace uses the regular webcam, for everything, with checks that keep it
  safe:
    - every scan must see a live face (not a photo or a screen) with open
      eyes looking at the screen
    - sudo and system prompts always wait for you to press Enter or click
    - three failed tries and it waits for your password once
EOF
  else
    echo "  IR camera: $what"
    # Many laptops keep the IR light off until it is switched on once.
    # omaFace is set up either way; this only says what to do about it.
    case $("$LIB/omaface-engine" emitter 2>/dev/null || true) in
      *'"pulsing"'* | *'"steady"'*) echo "  IR light: on" ;;
      *'"dark"'*)
        cat <<'EOF'
  IR light: did not come on. Many Lenovo, Dell and HP laptops need it switched
  on once:
      omarchy pkg aur add linux-enable-ir-emitter
      sudo linux-enable-ir-emitter configure
  then check with: omaface emitter
EOF
        ;;
      *) echo "  IR light: could not check (camera busy?); check later with: omaface emitter" ;;
    esac
  fi

  step "Setting up the system (root)"
  echo "  PAM: sudo, polkit$([[ $OMAFACE_LOGIN == yes ]] && echo " and login") get one omaFace line above the password;"
  echo "       originals are backed up to /var/lib/omaface/pam-backup"
  run_root _setup-root "$OMAFACE_LOGIN" "$webcam" || die "system setup failed; passwords work as before"

  step "Installing the shell plugin"
  local stage="${XDG_RUNTIME_DIR:-/tmp}/omaface-plugin.$$" backup manifest dir old
  build_plugin "$stage" || die "the shell plugin could not be built for this Omarchy; the lock screen is unchanged"
  # An earlier omaFace build under another plugin id (a lock screen clone
  # that ships FaceGlyph.qml): switch it off, which hands the lock back to
  # Omarchy for a moment, and keep a copy, so two lock screens never compete.
  for manifest in "$(dirname "$PLUGIN_DEST")"/*/manifest.json; do
    [[ -f $manifest ]] || continue
    dir=$(dirname "$manifest")
    old=$(jq -r '.id // ""' "$manifest" 2>/dev/null)
    [[ -n $old && $old != "$PLUGIN_ID" && -f $dir/FaceGlyph.qml ]] || continue
    jq -e '.omarchy.clonedFrom == "omarchy.lock"' "$manifest" >/dev/null 2>&1 || continue
    echo "  replacing the earlier omaFace plugin $old"
    omarchy plugin disable omarchy.polkit >/dev/null 2>&1 || true
    omarchy plugin disable "$old" >/dev/null 2>&1 || true
    mkdir -p "$PLUGIN_BACKUPS"
    mv "$dir" "$PLUGIN_BACKUPS/$old-$(date +%Y%m%d-%H%M%S)"
  done
  backup=$(replace_plugin "$stage")
  rm -rf "$stage"
  [[ -z $backup ]] || echo "  previous copy kept in $backup"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 40); do
    omarchy plugin list --json 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null && break
    sleep 0.1
  done

  step "Handing the lock screen and polkit dialog to omaFace"
  cp -a "$HOME/.config/omarchy/shell.json" "$HOME/.config/omarchy/shell.json.bak.omaface.$(date +%s)"
  # Polkit first: two agents cannot be registered at once.
  omarchy plugin disable omarchy.polkit >/dev/null
  omarchy plugin enable "$PLUGIN_ID" >/dev/null
  omarchy restart shell >/dev/null 2>&1 || true
  if ! wait_plugin_live; then
    fallback_to_stock
    die "the plugin did not come up, so Omarchy's own lock screen is back; see: journalctl --user -b | grep -i omaface"
  fi
  timeout 3 omarchy-shell lock status >/dev/null || die "lock screen IPC not answering"
  echo "  lock screen and polkit dialog now run from $PLUGIN_ID"

  step "Update hook"
  # From installs that kept the launcher entry per user (it is system-wide
  # now), some under the old name.
  rm -f "$HOME/.local/share/applications/faceid.desktop" "$HOME/.local/share/applications/omaface.desktop" \
    "$HOME/.local/share/icons/hicolor/scalable/apps/faceid.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/omaface.svg" \
    "$HOME/.config/omarchy/hooks/post-update.d/faceid"
  # After `omarchy update`: rebuild the plugin when Omarchy's lock screen
  # changed, and fall back to Omarchy's own if it no longer loads.
  install -Dm0755 "$SHARE/hooks/post-update" "$HOME/.config/omarchy/hooks/post-update.d/omaface"
  echo "  ok"

  step "Done"
  cmd_doctor --quiet || true
  if [[ $(appearance_count "$(id -un)") -eq 0 ]]; then
    cat <<'EOF'

  Next: enroll your face (sit in front of the laptop, lid open):
      omaface enroll              in a terminal
      omaface settings            or the omaFace window (also in the app launcher)
EOF
  fi
  cat <<'EOF'

  Your password keeps working everywhere. Undo it all with: omaface uninstall
EOF
}

cmd_uninstall() {
  (( EUID != 0 )) || die "run uninstall as your user; it asks for root itself"
  [[ -z ${1:-} || $1 == --keep-data ]] || die "usage: omaface uninstall [--keep-data]"

  echo "Handing the lock screen and polkit dialog back to Omarchy"
  omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  omarchy plugin enable omarchy.lock >/dev/null 2>&1 || true
  omarchy plugin enable omarchy.polkit >/dev/null 2>&1 || true
  omarchy restart shell >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 30); do timeout 3 omarchy-shell lock status >/dev/null 2>&1 && break; sleep 0.5; done

  if [[ -d $PLUGIN_DEST ]]; then
    local backup="$PLUGIN_BACKUPS/$PLUGIN_ID-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$PLUGIN_BACKUPS"
    mv "$PLUGIN_DEST" "$backup"
    echo "Plugin moved to $backup"
  fi
  rm -f "$HOME/.local/share/applications/omaface.desktop" \
    "$HOME/.local/share/icons/hicolor/scalable/apps/omaface.svg" \
    "$HOME/.config/omarchy/hooks/post-update.d/omaface"

  echo "Removing the system parts (root)"
  run_root _teardown "$@"
  if packaged; then
    echo "The omaface package is still installed; remove it with: sudo pacman -Rns omaface"
  fi
}

case "${1:-status}" in
  status) shift || true; cmd_status "$@" ;;
  ready) shift; cmd_ready "$@" ;;
  enroll | add) shift; cmd_enroll "$@" ;;
  test) shift; cmd_test "$@" ;;
  cameras) cmd_cameras ;;
  choose) shift; cmd_choose "$@" ;;
  reset) cmd_reset ;;
  emitter) cmd_emitter ;;
  remove) shift; cmd_remove "$@" ;;
  rename) shift; cmd_rename "$@" ;;
  enable | disable) cmd_toggle "$@" ;;
  set) shift; cmd_set "$@" ;;
  settings) cmd_settings ;;
  sync) cmd_sync ;;
  doctor) shift; cmd_doctor "$@" ;;
  setup) cmd_setup ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  # The root halves of setup and uninstall (through run_root).
  _setup-root)
    (( EUID == 0 )) || die "internal command"
    [[ ${2:-} =~ ^(yes|no)$ && ${3:-} =~ ^(yes|no)$ ]] || die "usage: omaface _setup-root <login> <webcam>"
    exec "$LIB/setup-root" "$2" "$3" ;;
  _teardown)
    (( EUID == 0 )) || die "internal command"
    [[ -z ${2:-} || $2 == --keep-data ]] || die "usage: omaface _teardown [--keep-data]"
    # A git install also takes its files away; pacman does that for the package.
    if [[ -x $LIB/uninstall ]]; then exec "$LIB/uninstall" ${2:+"$2"}; fi
    exec "$LIB/teardown" ${2:+"$2"} ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
